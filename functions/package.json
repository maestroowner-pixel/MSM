{
  "name": "msm-functions",
  "description": "Marine Safety Manager \u2014 enrolment (account issuance) on the server side.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "secret": "npx firebase-tools functions:secrets:set BOOTSTRAP_CODE --project marine-safety-manager",
    "secret:smtp:user": "npx firebase-tools functions:secrets:set SMTP_USER --project marine-safety-manager",
    "secret:smtp:pass": "npx firebase-tools functions:secrets:set SMTP_PASS --project marine-safety-manager",
    "deploy": "cd .. && npx firebase-tools deploy --only functions --project marine-safety-manager",
    "logs": "cd .. && npx firebase-tools functions:log --project marine-safety-manager",
    "code": "node scripts/setup-code.js",
    "modules": "node scripts/set-modules.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^6.9.16"
  }
}
