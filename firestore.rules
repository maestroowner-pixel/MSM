rules_version = '2';

// ===================================
// Access is decided by the CLAIMS in a token, not by "the uid matches".
//
// Every device used to sign in as the one shared vessel account, so
// `request.auth.uid == uid` was the whole model — and with it the rules could not
// tell an approved phone from a revoked one, a deckhand from the Master, or the
// app from a script written by somebody who had been told the connection password
// once. Roles and approvals were honest arrangements between colleagues.
//
// Now a device gets its own token from functions/index.js, carrying:
//
//     vessel      the IMO digits whose register it may touch
//     role        user | admin | superadmin
//     approved    only ever true — an unapproved device is given no token at all
//     deviceId    which install it is
//
// Everything below is written against those claims, so a promotion means a NEW
// token and a client cannot edit its way up. The Admin SDK ignores these rules,
// which is why the function can write what they deny to everyone: roles,
// approvals, the activation journal and the attempt counters.
//
// THE INSPECTION TRAIL IS APPEND-ONLY IN THE RULES TOO. That is the point of the
// whole feature: a record that a device could quietly rewrite afterwards is worth
// nothing at an audit, and enforcing it only in the app would leave the guarantee
// resting on the app being the only writer. Create is allowed to any member;
// update is allowed ONLY to the defect fields, and only to an officer; delete is
// allowed to nobody at all, including the Master.
// ===================================

service cloud.firestore {
  match /databases/{database}/documents {

    function claims() {
      return request.auth.token;
    }

    /** A device of this vessel, approved, holding a token the function issued. */
    function member(v) {
      return request.auth != null
             && claims().vessel == v
             && claims().approved == true;
    }

    function isSuper(v) {
      return member(v) && claims().role == 'superadmin';
    }

    function isAdmin(v) {
      return member(v) && (claims().role == 'admin' || claims().role == 'superadmin');
    }

    /**
     * A superintendent's fleet token (functions/index.js `refreshShore`): the
     * vessels its holder was let into, each by that vessel's Master. Reads those
     * vessels; writes only their ISM documents. Certificates are changed through
     * the `shoreSaveCertificate` function, never by writing the register.
     */
    function shore(v) {
      return request.auth != null
             && claims().shore == true
             && claims().fleet is map
             && claims().fleet[v] == true;
    }

    // A record that replaces another (an amendment or a deletion, services/versions)
    // is the Master's alone, in every log.
    function plainRecord() {
      return !('supersedes' in request.resource.data);
    }
    function sameVersion() {
      return request.resource.data.get('supersedes', null) == resource.data.get('supersedes', null);
    }

    function reader(v) {
      return member(v) || shore(v);
    }

    match /safety_vessels/{v} {
      // The register itself — one document holding the whole snapshot. Everyone
      // who is in may read and write it: that is the data model.
      allow read: if reader(v);
      // `modules` — modules switched on for this vessel only (constants/modules
      // `setVesselModules`) — is set by us, with admin credentials, and by no
      // device: not even a Master, since it is what the vessel has been sold.
      allow create: if member(v) && !('modules' in request.resource.data);

      // …but NOT the licence. `entitlement` sits on this same document, and MSM
      // Pro is now licensed per vessel and read from it — so leaving it writable
      // by any member would let any crew phone grant the whole ship Pro by
      // writing one field. Only a Master may touch it. Everything else on the
      // document (the register blob, masterDeviceId, the trial stamp) stays open
      // to members, because that IS the shared data.
      //
      // `signingPolicy` is the same kind of field: "Crew and Officers must scan
      // the item's QR label before signing". A rule any crew phone could switch
      // off with one write would be a suggestion, so only a Master sets it.
      //
      // `photoArchive` is the third, and the most consequential of them: its
      // `archivedThrough` is what permits the scheduled sweep to DELETE evidence
      // photographs older than 90 days (services/photoArchive.ts). A device that
      // could claim "everything up to today is archived" could have the vessel's
      // own evidence erased by a job running at 3 a.m. with nobody watching. The
      // sweep itself writes here too — it runs with admin credentials and is not
      // subject to these rules.
      allow update: if member(v)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['modules'])
                    && (isSuper(v)
                        || !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['entitlement', 'signingPolicy', 'photoArchive', 'emailReport', 'inspectToken', 'inspectTokenExpiry', 'icsToken']));
      allow delete: if false;

      // ---- devices ---------------------------------------------------------
      match /devices/{deviceId} {
        allow read: if reader(v);

        // A device may keep its OWN record current — platform, app version. It may
        // not touch what decides its powers, and since 25 Sep 2026 it may not
        // touch its own NAME either.
        //
        // The name stopped being cosmetic when "Sign as the device's account"
        // arrived (services/signingPolicy `signAsDevice`): with that rule on, the
        // name on the device record IS the signature on every inspection it
        // files. A crew member who could rename their own handset could sign as
        // the Master, which is the precise thing the rule exists to prevent. So
        // who a device belongs to is the Master's to set, in Accounts → Rename,
        // and a vessel asked for exactly that in those words. Likewise `tabs`,
        // which tabs the device shows, `manage`, which places it may manage, and
        // `hidePages`, which menu pages it does not show (Settings → Access, and
        // the Master's page).
        allow update: if member(v)
                      && deviceId == claims().deviceId
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'approved', 'disabled', 'secretHash', 'secretSalt',
                                     'firstName', 'lastName', 'position', 'tabs', 'manage', 'hidePages']);

        // Approving, demoting and switching off are the Master's, and are the
        // reason a Master exists.
        allow write: if isSuper(v);
      }

      // ---- invitations (the accounts a Master issues) -----------------------
      // Readable only by the Master: the PIN is stored readable so it can be read
      // out again to the person it was issued to, which means anyone who can read
      // this collection can enrol as anyone in it.
      match /invites/{inviteId} {
        allow read, write: if isSuper(v);
      }

      // ---- the audit trail -------------------------------------------------
      match /inspections/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        // Only the defect may change, and only an officer may change it. The
        // signature, the time, the results and the outcome are frozen.
        allow update: if isAdmin(v)
                      && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['defect', 'updatedAt']);
        allow delete: if false;
      }

      // The signing vocabulary. Any member READS it — the picker needs it to sign
      // — but only a Master writes it. It was `isAdmin` (Officer and above) and
      // that was one rank too generous: the list decides whose name may appear on
      // a signed record, so adding to it is closer to issuing an account than to
      // doing a round. Officers ask the Master, as they do for accounts.
      match /crew/{id} {
        allow read: if reader(v);
        // The Master and the Officers (Chief Officer) keep the crew list.
        allow write: if isAdmin(v);
      }

      // Hours of rest, one document per person per day (types/rest.ts). Any
      // member reads and writes: a seafarer keeps their own record on their own
      // phone, an officer or the Master corrects it, and the Master signs off the
      // month from the same data. Not deletable: a day corrected is overwritten,
      // never removed, so a breach cannot be made to disappear by deleting it.
      match /rest/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }

      // Planned maintenance (types/pms.ts). The plan — systems, jobs, intervals,
      // removal by tombstone — is the Master's or the superintendent's (11 Oct
      // 2026). Every member still writes what the work changes: the counter
      // reading on a machine, the last-done date and hours on a job. Never
      // deleted. A completed job is a signed record and is append-only, like an
      // inspection: created once, never changed, never deleted.
      function plans(v) {
        return isSuper(v) || shore(v);
      }
      function onlyChanges(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      match /pms_machines/{id} {
        allow read: if reader(v);
        allow create: if plans(v);
        allow update: if plans(v) || (member(v) && onlyChanges(['hours', 'hoursDate', 'readings', 'counterOffset', 'updatedAt']));
        allow delete: if false;
      }
      match /pms_jobs/{id} {
        allow read: if reader(v);
        allow create: if plans(v);
        // A member signs a job out (its last-done), or writes it up for an officer to sign (prepared).
        allow update: if plans(v) || (member(v) && onlyChanges(['lastDoneDate', 'lastDoneHours', 'prepared', 'updatedAt']));
        allow delete: if false;
      }
      match /pms_done/{id} {
        allow read: if reader(v);
        // A cancelling version (a wrong sign-out, within 30 days) is the Master's.
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      // A defect found on machinery: raised by any member, closed (only the
      // `closed` block) by an officer or the Master. Never deleted.
      match /pms_defects/{id} {
        allow read: if reader(v);
        allow create: if member(v) && !('closed' in request.resource.data);
        allow update: if isAdmin(v) && onlyChanges(['closed', 'updatedAt']) && !('closed' in resource.data);
        allow delete: if false;
      }
      // A project (yard period, dry dock) — part of the plan: the Master's or the superintendent's.
      match /pms_projects/{id} {
        allow read: if reader(v);
        allow create, update: if plans(v);
        allow delete: if false;
      }
      // Internal audits (ISM / MLC / custom) — Officers create and update while open; signed → no change.
      match /internal_audits/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Shore movements — append-only by Officers; any member reads.
      match /item_movements/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v);
        allow update: if isAdmin(v);
        allow delete: if false;
      }
      // Landing / handover reports — Officers create and sign; any member reads.
      match /landings/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Engine-room round template — Officers and Master edit it; everyone reads.
      match /watch_templates/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Engine-room round entries — any member signs one; immutable once written.
      match /watch_log/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }
      // A job deferred — the Master's decision, signed, kept.
      match /pms_deferrals/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      // Spare parts: the stocked lines are edited (tombstoned, never deleted);
      // their movements are append-only, because stock is their sum.
      match /spares/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /spare_moves/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }
      // ISM documents: issued and revised by Officers and the Master; signed
      // for ("read and understood") by everyone, once per person per revision.
      match /ism_docs/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v) || shore(v);
        allow delete: if false;
      }
      // Permits to work and risk assessments: anyone aboard requests and edits
      // (the app enforces who approves, and signs each step); never deleted.
      match /permits/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /risk_assessments/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      // Fuel: tanks, daily soundings, bunkerings, transfers — kept by whoever
      // is on watch; never deleted (a wrong figure is corrected, not erased).
      match /fuel_tanks/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /fuel_readings/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        // Signed records are changed only by a new version (the Master's).
        allow update: if isSuper(v);
        allow delete: if false;
      }
      match /fuel_bunkers/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        // Signed records are changed only by a new version (the Master's).
        allow update: if isSuper(v);
        allow delete: if false;
      }
      match /fuel_transfers/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        // Signed records are changed only by a new version (the Master's).
        allow update: if isSuper(v);
        allow delete: if false;
      }
      // Fuel daily (noon) reports as sent — a log, written once.
      match /fuel_daily/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }
      // Inspection rounds (types/round.ts): started and closed by an officer or the
      // Master; the inspections in them are ordinary signed records.
      match /rounds/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v);
        allow update: if isAdmin(v) && resource.data.get('closedAt', null) == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closedAt', 'closedBy', 'closedByRank', 'closedWith', 'closeNote', 'updatedAt']);
        allow delete: if false;
      }
      // Sewage and Ballast Water record books — kept like the Oil Record Book.
      match /sewage/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /sewage_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      match /ballast/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /ballast_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      // Fuel oil changeover (Annex VI reg. 14.6) and the ODS Record Book (reg. 12.6) — the same.
      match /fuel_changeover/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /fuel_changeover_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      match /ods/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /ods_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      // Oil Record Book Part I: entries written once; a change or deletion is a
      // new version, the Master's; the Master signs each month.
      // The record books' signing keys (services/seal): each signer's public key,
      // written once by the device that made it; and who opened or exported a
      // book (services/bookAccess) — written once, never changed.
      match /sign_keys/{id} {
        allow read: if reader(v);
        allow create: if member(v) && request.resource.data.id == id;
        allow update, delete: if false;
      }
      match /book_access/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }
      match /orb/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /orb_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      // Garbage Record Book (MARPOL Annex V): entries and the Master's monthly
      // signatures are written once and never changed — as in the paper book,
      // a mistake is corrected by a further entry.
      match /garbage/{id} {
        allow read: if reader(v);
        // A new version of an entry (amended / cancelled) is the Master's alone.
        allow create: if member(v) && (!('supersedes' in request.resource.data) || isSuper(v));
        allow update, delete: if false;
      }
      match /garbage_signs/{id} {
        allow read: if reader(v);
        allow create: if isSuper(v);
        allow update, delete: if false;
      }
      // SOPEP: the locker list is edited; inventory checks and drills are
      // records, written once.
      match /sopep_items/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      // SOPEP lockers (types/sopep.ts): name and place, kept as the items are.
      // The SOPEP's papers and the Ship Security Plan (types/officerDocs.ts): the
      // Master and the officers only — the plan is need-to-know (ISPS A/9.7).
      match /sopep_docs/{id} {
        allow read, create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /ssp_docs/{id} {
        allow read, create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Stowaway and bomb searches (types/searches.ts): the officers keep the plan
      // of areas and teams; anyone on board records the areas searched.
      match /search_plan/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /searches/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      // Security rounds (types/patrols.ts): the officers keep the places and the
      // rounds; anyone on watch files a round done — once, never changed.
      match /checkpoints/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /patrol_plans/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /patrols/{id} {
        allow read: if reader(v);
        allow create: if member(v) && plainRecord();
        allow update, delete: if false;
      }
      // The key register (types/keys.ts): the officers keep the list of keys;
      // anyone at the key cabinet records an issue or a return — once, never changed.
      match /keys/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /key_moves/{id} {
        allow read: if reader(v);
        allow create: if member(v) && plainRecord();
        allow update, delete: if false;
      }
      match /sopep_lockers/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /sopep_checks/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /sopep_drills/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      // Security (ISPS): the visitor log is written by the gangway watch and
      // updated to sign a visitor out; the security level by an Officer or the
      // Master (the Ship Security Officer), kept as history.
      match /visitors/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        // Signing a visitor off is an update; making it another version is not.
        allow update: if member(v) && (sameVersion() || isSuper(v));
        allow delete: if false;
      }
      // Surveys & audits: the plan is kept by the Officers and the Master; each
      // occasion carried out is a record, written once. The shore can read.
      match /surveys/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /surveys_done/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      // QHSE (types/safety.ts). An observation card is anybody's to write; an
      // officer or the Master reviews it, and the review is all that changes.
      match /observations/{id} {
        allow read: if reader(v);
        allow create: if member(v) && !('reviewedAt' in request.resource.data);
        allow update: if isAdmin(v) && onlyChanges(['reviewedAt', 'reviewedBy', 'reviewedByRank', 'review', 'ncId', 'updatedAt']);
        allow delete: if false;
      }
      // A non-conformity is raised and worked by the officers; anyone on board
      // signs off the action given to him; only the Master (or the shore) closes
      // it, and a closed one is final.
      match /ncs/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && !('closedAt' in request.resource.data);
        allow update: if resource.data.get('closedAt', null) == null && (
                        plans(v)
                        || (isAdmin(v) && !('closedAt' in request.resource.data))
                        || (member(v) && onlyChanges(['actions', 'updatedAt'])));
        allow delete: if false;
      }
      // Drills (types/drills.ts): planned and run by an officer or the Master,
      // saved as they are written; signed as carried out, a drill is final.
      // The drill calendar (services/drillPlan.ts): one plan per year, kept by the officers.
      match /drill_plans/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /drills/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && plainRecord();
        // Anyone on board signs his own line of the attendance list.
        allow update: if resource.data.get('doneAt', null) == null
                        && (isAdmin(v) || (member(v) && onlyChanges(['attendance', 'updatedAt'])));
        allow delete: if false;
      }
      // Stores (types/stores.ts) — the PPE store and the provisions: anyone on
      // board keeps the list and moves stock; a move is never changed.
      match /store_items/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /store_moves/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }
      // The storerooms: named, placed, with a QR label — added from the Stores menu.
      match /store_rooms/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      // Monthly safety meeting (types/meetings.ts): as a drill — written by an
      // officer or the Master, each person on board signs his own attendance
      // line; signed by the Master, final.
      match /safety_meetings/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && plainRecord();
        allow update: if resource.data.get('doneAt', null) == null
                        && (isAdmin(v) || (member(v) && onlyChanges(['attendance', 'updatedAt'])));
        allow delete: if false;
      }
      // Dynamic positioning (types/dp.ts). A signed DP checklist is never changed
      // or removed; DP time is kept by anyone on board (a DPO enters his watch);
      // the letter's company details and the vessel's wording of the checklists
      // are the officers'.
      match /dp_checks/{id} {
        allow read: if reader(v);
        // Where it was done is required (16 Oct 2026): a position in degrees.
        allow create: if member(v) && plainRecord()
          && request.resource.data.position is map
          && request.resource.data.position.lat is number && request.resource.data.position.lon is number
          && request.resource.data.position.lat >= -90 && request.resource.data.position.lat <= 90
          && request.resource.data.position.lon >= -180 && request.resource.data.position.lon <= 180;
        allow update, delete: if false;
      }
      match /dp_days/{id} {
        allow read: if reader(v);
        allow create, update: if member(v);
        allow delete: if false;
      }
      match /dp_info/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /dp_templates/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Hospital (types/hospital.ts). The chest and its moves are kept by the
      // officers; moves are never changed. The medical log is health data: the
      // Master and the officers only — not the crew, not the shore.
      match /med_items/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /med_moves/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && !('patient' in request.resource.data);
        allow update, delete: if false;
      }
      // An entry never changes; the written medical advice may be added to it.
      // The patient's name never leaves the vessel: the cloud holds its first and
      // last letter only ("A…e"); an older copy with the full name may be masked.
      match /med_treatments/{id} {
        function masked() {
          return request.resource.data.patient is string && request.resource.data.patient.matches('^.(….)?$');
        }
        allow read: if isAdmin(v);
        allow create: if isAdmin(v) && masked();
        allow update: if isAdmin(v) && masked() && onlyChanges(['files', 'patient', 'updatedAt']);
        allow delete: if false;
      }
      // Orders: written and received against by the officers; closed, final.
      match /med_orders/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v) && !('closedAt' in request.resource.data);
        allow update: if isAdmin(v) && resource.data.get('closedAt', null) == null;
        allow delete: if false;
      }
      match /med_checks/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v);
        allow update, delete: if false;
      }
      // Passengers (types/passengers.ts) — confidential: the guest list does not
      // leave the vessel. Up here a guest is the first and last letter of the
      // name, the cabin and the dates; the documents are never sent.
      match /passengers/{id} {
        function masked() {
          return request.resource.data.name is string && request.resource.data.name.matches('^.(….)?$')
            && !('nationality' in request.resource.data) && !('notes' in request.resource.data);
        }
        allow read: if reader(v);
        allow create, update: if isAdmin(v) && masked();
        allow delete: if false;
      }
      match /passengers_private/{id} {
        allow read, write: if false;
      }
      // Crew going ashore / coming back aboard (QR crew card at the gangway).
      match /crew_moves/{id} {
        allow read: if reader(v);
        // A passenger's crossing carries the name masked (the guest list stays on board).
        allow create: if member(v) && (!(string(request.resource.data.get('crewId', '')).matches('^pax.*'))
                                       || string(request.resource.data.get('name', '')).matches('^.(….)?$'));
        allow update, delete: if false;
      }
      match /security_drills/{id} {
        allow read: if reader(v);
        allow create: if member(v) && (plainRecord() || isSuper(v));
        allow update, delete: if false;
      }
      match /security_levels/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v);
        allow update, delete: if false;
      }
      // Personal details and next of kin of the crew: Officers and the Master
      // only — the crew list itself is read by every device, these are not.
      match /crew_private/{id} {
        allow read, create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /ism_doc_acks/{id} {
        allow read: if reader(v);
        allow create: if member(v);
        allow update, delete: if false;
      }

      // The vessel's own checklists. Any member reads them — a round cannot be
      // carried out without the questions — and an OFFICER may write them. That
      // is deliberately one rank below the crew list: wording a check is the work
      // of whoever runs the round, while deciding whose name may appear on a
      // signed record is not.
      //
      // Editing one cannot corrupt the trail. Every inspection carries its own
      // copy of the questions it was signed against (types/inspection.ts), so
      // what this collection says today has no power over what was signed
      // yesterday — which is why an Officer can be trusted with it at all.
      match /templates/{id} {
        allow read: if reader(v);
        allow write: if isAdmin(v);
      }

      // Headings the vessel invented. Same rank as the checklists and for the same
      // reason — this is how the round is organised, not who may sign it.
      //
      // Deleting one here does NOT delete its items: they stay in the register,
      // which is a separate document, so a heading removed by mistake is undone
      // by adding it back rather than by restoring a backup.
      match /categories/{id} {
        allow read: if reader(v);
        allow write: if isAdmin(v);
      }

      // Purchase orders — any officer may raise and update; received/cancelled orders
      // keep the record but cannot be changed further. Crew may read (to see what was ordered).
      // Finance (types/finance.ts): the officers and the Master keep the APA and
      // the budget; the shore reads them. An APA entry is written once — a
      // mistake is taken out by a reversing entry, so a statement stays true.
      match /apa_funds/{id} {
        allow read: if isAdmin(v) || shore(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /apa_entries/{id} {
        allow read: if isAdmin(v) || shore(v);
        allow create: if isAdmin(v);
        allow update, delete: if false;
      }
      match /budget/{id} {
        allow read: if isAdmin(v) || shore(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      // Supplier directory (types/suppliers.ts): read by all, kept by the officers;
      // a supplier is retired with `deleted`, never removed — orders name them.
      match /suppliers/{id} {
        allow read: if reader(v);
        allow create, update: if isAdmin(v);
        allow delete: if false;
      }
      match /purchase_orders/{id} {
        allow read: if reader(v);
        allow create: if isAdmin(v);
        allow update: if isAdmin(v)
          && !(resource.data.status == 'received' || resource.data.status == 'cancelled');
        allow delete: if false;
      }

      // ---- server-only ------------------------------------------------------
      // The bootstrap marker and the guess counters are written by the Admin SDK
      // and must be unreachable from a client — a counter the guesser can clear
      // is not a rate limit.
      match /meta/{doc} {
        allow read: if reader(v);
        allow write: if false;
      }
      match /enrolAttempts/{doc} {
        allow read, write: if false;
      }
    }
  }
}
